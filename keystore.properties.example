# Copiar a keystore.properties (ignorado por Git) en la raíz del proyecto mpaz-neb.
# Generar el .jks dedicado a la evaluación (no usar llaves personales):
#
# keytool -genkeypair -v -storetype PKCS12 ^
#   -keystore mpaz-neb-ep4-release.jks -alias mpaznebEp4 ^
#   -keyalg RSA -keysize 2048 -validity 10000 ^
#   -dname "CN=MPAZ NEB EP4, OU=DSY1105, O=Duoc UC, L=Santiago, ST=RM, C=CL"
#
storeFile=mpaz-neb-ep4-release.jks
storePassword=CAMBIAR_LOCALMENTE
keyAlias=mpaznebEp4
keyPassword=CAMBIAR_LOCALMENTE